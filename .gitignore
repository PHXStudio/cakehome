# This .gitignore file should be placed at the root of your Unity project directory
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore

# =====================
# Unity 中间产物（必忽略）
# =====================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures / Recordings 体积可能很大，且可能含敏感信息
/[Mm]emoryCaptures/
/[Rr]ecordings/

# =====================
# IDE / 编辑器生成
# =====================
# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo/Rider solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.idea/

# Unity3D generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# =====================
# 构建产物
# =====================
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets (gradle build)
/[Aa]ssets/[Ss]treamingAssets/aaa/
/[Aa]ssets/[Ss]treamingAssets/aaa.meta

# =====================
# 操作系统文件
# =====================
.DS_Store*
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Cursor 编辑器本地配置
.cursor/

# Unity MCP local server
unity-mcp/node_modules/
unity-mcp/dist/

# =====================
# HybridCLR 工具自动生成物（不入库）
# =====================
# 工具 clone 的源码仓库（嵌套 git）
/HybridCLRData/hybridclr_repo/
/HybridCLRData/il2cpp_plus_repo/
# 本地 il2cpp 构建缓存
/HybridCLRData/LocalIl2CppData-*/
# 编译产物 dll（可随时用 HybridCLR/CompileDll 重新生成）
/HybridCLRData/HotUpdateDlls/
/HybridCLRData/AssembliesPostIl2CppStrip/
# IL2CPP 临时构建项目
/HybridCLRData/StrippedAOTDllsTempProj/
