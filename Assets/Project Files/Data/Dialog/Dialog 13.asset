  m_Name: Dialog 13
  m_EditorClassIdentifier:
  chapterTitle: The Neighborhood Is Ready
  steps:
  - rid: 8844046230112102412
  - rid: 5809915938811059910
  - rid: 2469429878704354405
  - rid: 3261421738286269291
  - rid: 7187669169317613020
  - rid: 8169114165723542866
