#!/bin/sh
# ============================================================================
# 🔴 敏感信息提交防护 Hook v2
# 单次扫描本次暂存 diff 的新增/修改行，命中 token/密钥模式则阻止提交。
# v1 逐文件 git show 在文件多时极慢（大 merge 会卡死），v2 改为一次 diff。
# 团队启用：git config core.hooksPath .githooks
# 临时绕过：git commit --no-verify（确认内容安全后使用）
# ============================================================================

# 敏感模式（grep -E 语法，每行一个）
SENSITIVE_PATTERNS='
gh[opu]_[A-Za-z0-9]{20,}
github_pat_[A-Za-z0-9_]{20,}
sk-[A-Za-z0-9]{20,}
AKIA[0-9A-Z]{16}
AIza[0-9A-Za-z_-]{35}
xox[baprs]-[0-9A-Za-z-]{10,}
BEGIN [A-Z ]*PRIVATE KEY
(password|passwd|api[_-]?key|secret|client[_-]?secret)[[:space:]]*[:=][[:space:]]*["'"'][^"'"']{8,}["'"']
'

# 文档/测试中的示例密钥白名单（刻意放置的假值，放行；仅在确实为假值时追加）
ALLOWED_SAMPLES='
sk-ABC1234567890abcdefghijklmnopqrstuvwxyz
ghp_ABC1234567890abcdefghijklmnopqrstuvwxyz
'

PATFILE="$(mktemp 2>/dev/null || echo "/tmp/precommit-pat.$$")"
SAMPLEFILE="$(mktemp 2>/dev/null || echo "/tmp/precommit-samples.$$")"
printf '%s\n' "$SENSITIVE_PATTERNS" | grep -v '^[[:space:]]*$' > "$PATFILE"
printf '%s\n' "$ALLOWED_SAMPLES"    | grep -v '^[[:space:]]*$' > "$SAMPLEFILE"
trap 'rm -f "$PATFILE" "$SAMPLEFILE"' EXIT

# 单次取全部暂存 diff（-U0 无上下文；二进制只显示 "Binary files ..." 摘要，天然安全）
DIFF="$(git diff --cached -U0 --no-color 2>/dev/null)"
[ -z "$DIFF" ] && exit 0

# 提取新增行（^+ 开头，排除 +++ 文件头），收集所有命中
HITS="$(printf '%s\n' "$DIFF" | grep '^+' | grep -v '^+++' | grep -Ef "$PATFILE" -o 2>/dev/null || true)"

FOUND=0
if [ -n "$HITS" ]; then
    while read -r m; do
        if ! grep -qxF "$m" "$SAMPLEFILE" 2>/dev/null; then
            echo "❌ 敏感信息拦截: 本次新增内容命中 '$m'"
            echo "   （临时绕过: git commit --no-verify）"
            FOUND=1
        fi
    done <<EOF
$HITS
EOF
fi

if [ "$FOUND" -ne 0 ]; then
    echo ""
    echo "🚫 提交已阻止。请移除敏感信息后重试。"
    exit 1
fi
exit 0
